"""Target platforms for SourceMod extensions.

Most Source-engine dedicated servers (srcds) are 32-bit, so extensions must be
built as 32-bit shared objects to be loadable. The old build hardcoded `-m32`
into every compile and link action; expressing it as a platform instead lets the
C++ toolchain resolve correctly and keeps 64-bit builds (used by newer engine
branches) a one-flag change.

Usage:
    bazel build --platforms=@rules_sourcemod//platforms:linux_x86_32 //...
"""

package(default_visibility = ["//visibility:public"])

# Lets macros (which run before configuration, so ctx.target_platform_has_constraint
# is unavailable) branch on word size with select(), the same way rule
# implementations already do via the cpu constraint directly.
config_setting(
    name = "x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
)

# 64-bit Windows and macOS specifically. SourceHook's x86_64 hookman generator
# is built on every 64-bit target *except* Linux (core/AMBuilder), so selecting
# on word size alone is not enough to express where it belongs.
config_setting(
    name = "windows_x86_64_setting",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "macos_x86_64_setting",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

# Same, for OS: lets server.bzl's renames pick '.dll' vs '.so' with a plain
# select() (a linkshared cc_binary's own outputs can't disambiguate that by
# themselves -- see sourcemod/rename.bzl).
config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

# Metamod's own install layout (unlike SourceMod's own binaries above it,
# which only vary by arch -- see server.bzl) additionally splits by OS on a
# 64-bit target: addons/metamod/bin/{linux64,win64}/server.<so|dll>, vs. a
# single addons/metamod/bin/server.<so|dll> shared by 32-bit Windows and
# Linux alike. This is the more specific condition server.bzl's select()
# checks before falling back to the plain `x86_64` one above for 64-bit
# Linux -- Bazel resolves the overlap by specialization, the same way
# hl2sdk.BUILD.bazel's tier0_import/vstdlib_import aliases do.
#
# Named distinctly from the `windows_x86_64` platform() below -- a
# config_setting and a platform can't share a name in the same package.
config_setting(
    name = "is_windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_x86_32",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_32",
    ],
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "windows_x86_32",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_32",
    ],
)

platform(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)
