+
+			// clang-cl (rules_sourcemod's cross-compiling toolchain -- see
+			// windows/xwin_sysroot.bzl) never emits the compact
+			// jmp-through-memory thunk real MSVC does (matched further
+			// below). It loads the vtable slot into eax and tail-jumps
+			// through the register instead, wrapped in a frame whose shape
+			// depends on the optimization level:
+			//
+			//   55                push ebp               } frame pointer: always
+			//   89 e5             mov  ebp, esp          } at /Od, and at /O2
+			//                                            } with /Oy- (upstream's
+			//                                            } and Bazel's default)
+			//   50                push eax               ) /Od only: spill and
+			//   89 4d fc          mov  [ebp-4], ecx      ) reload `this`
+			//   8b 4d fc          mov  ecx, [ebp-4]      )
+			//   8b 01             mov  eax, [ecx]          vtable pointer
+			//   8b 00             mov  eax, [eax]          slot 0, or
+			//   8b 40 ib          mov  eax, [eax+ib]       slot 1-31, or
+			//   8b 80 id          mov  eax, [eax+id]       slot 32+
+			//   83 c4 04          add  esp, 4            ) /Od only
+			//   5d                pop  ebp               } frame pointer only
+			//   ff e0             jmp  eax
+			//
+			// Every optional part is matched exactly and the trailing
+			// `jmp eax` is required, so an ordinary function that merely
+			// begins with the same bytes is not mistaken for a thunk.
+			//
+			// Anything unmatched falls through to the MSVC patterns below,
+			// which report it as non-virtual rather than failing -- so a
+			// thunk shape missing from this list does not error, it installs
+			// every hook declared through it at the wrong address. Each
+			// shape listed here was seen to do exactly that before it was
+			// added: the /Od one in a minimal SourceHook repro (a null vtable
+			// slot jumped through on the first hooked call), the /O2 one as
+			// srcds dying at startup in metamod.2.ep1.dll reading a
+			// ConVar's FLT_MAX as a pointer, and SourceMod failing to load
+			// once MetaMod alone was built at /Od.
+			{
+				unsigned char *p = addr;
+				bool frame = false, spill = false;
+				if (p[0] == 0x55 && p[1] == 0x89 && p[2] == 0xE5)
+				{
+					p += 3;
+					frame = true;
+					if (p[0] == 0x50 && p[1] == 0x89 && p[2] == 0x4D && p[3] == 0xFC &&
+						p[4] == 0x8B && p[5] == 0x4D && p[6] == 0xFC)
+					{
+						p += 7;
+						spill = true;
+					}
+				}
+				if (p[0] == 0x8B && p[1] == 0x01 && p[2] == 0x8B)
+				{
+					p += 3;
+					unsigned long offset = 0;
+					bool ok = true;
+					if (p[0] == 0x00)
+						p += 1;
+					else if (p[0] == 0x40)
+					{
+						offset = p[1];
+						p += 2;
+					}
+					else if (p[0] == 0x80)
+					{
+						offset = *(unsigned long*)(p + 1);
+						p += 5;
+					}
+					else
+						ok = false;
+					if (ok && spill)
+					{
+						ok = p[0] == 0x83 && p[1] == 0xC4 && p[2] == 0x04;
+						p += 3;
+					}
+					if (ok && frame)
+					{
+						ok = p[0] == 0x5D;
+						p += 1;
+					}
+					if (ok && p[0] == 0xFF && p[1] == 0xE0)
+						return offset / SH_PTRSIZE;
+				}
+			}
 	
