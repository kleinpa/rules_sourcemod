# Mirrors lib/config-win32.h directly while defining HEADER_CURL_CONFIG_WIN32_H
# so curl_setup.h skips config-win32.h (and its obsolete `_MSC_VER > 1800` check)
# without needing a source patch.
_WINDOWS_COPTS = [
    "/W0",
    "/DHEADER_CURL_CONFIG_WIN32_H",
    "/DBUILDING_LIBCURL",
    "/DCURL_DISABLE_LDAP",
    "/DUSE_IPV6",
    "/DUSE_RESOLV_THREADED=1",
    "/DUSE_SCHANNEL",
    "/DUSE_UNIX_SOCKETS=1",
