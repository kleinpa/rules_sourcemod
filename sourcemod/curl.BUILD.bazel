cc_library(
    name = "curl_private_includes",
    includes = ["lib"],
    visibility = ["//visibility:private"],
)

# Linux links BoringSSL and trusts the Debian/Ubuntu/Steam Runtime CA bundle;
# Windows uses native Schannel + the OS certificate store with no external TLS dep.
cc_library(
    name = "curl_private",
    srcs = glob([
        "include/curl/*.h",
        "lib/**/*.c",
        "lib/**/*.h",
    ]),
    copts = select({
        "@rules_sourcemod//platforms:is_windows_x86_64": _WINDOWS_COPTS + [
            "/DSIZEOF_SIZE_T=8",
            "/Dssize_t=__int64",
            "/DCURL_OS=\"x86_64-pc-win32\"",
        ],
        "@platforms//os:windows": _WINDOWS_COPTS + [
            "/DSIZEOF_SIZE_T=4",
            "/Dssize_t=int",
            "/DCURL_OS=\"i386-pc-win32\"",
        ],
        "@rules_sourcemod//platforms:is_linux_x86_32": _LINUX_COPTS + [
            "-DSIZEOF_LONG=4",
            "-DSIZEOF_SIZE_T=4",
            "-DSIZEOF_TIME_T=4",
        ],
        "//conditions:default": _LINUX_COPTS + [
            "-DSIZEOF_LONG=8",
            "-DSIZEOF_SIZE_T=8",
            "-DSIZEOF_TIME_T=8",
        ],
    }),
    features = WINDOWS_CRT_FEATURES,
    implementation_deps = [":curl_private_includes"],
    includes = ["include"],
    # Lowercase .lib names so lld-link resolves them on case-sensitive xwin sysroots.
    linkopts = select({
        "@platforms//os:windows": [
            "advapi32.lib",
            "bcrypt.lib",
            "crypt32.lib",
            "iphlpapi.lib",
            "normaliz.lib",
            "secur32.lib",
            "ws2_32.lib",
        ],
        "//conditions:default": ["-lpthread"],
    }),
    linkstatic = True,
    local_defines = ["CURL_STATICLIB"] + select({
        "@platforms//os:windows": [],
        "//conditions:default": [
            "USE_OPENSSL",
            "HAVE_BORING_SSL=1",
            'CURL_CA_BUNDLE=\\"/etc/ssl/certs/ca-certificates.crt\\"',
            'CURL_CA_PATH=\\"/etc/ssl/certs\\"',
        ],
    }),
    visibility = ["//visibility:private"],
    deps = select({
        "@platforms//os:windows": [],
        "//conditions:default": [
            "@boringssl//:crypto",
            "@boringssl//:ssl",
        ],
    }),
)

cc_library(
    name = "curl",
    hdrs = glob(["include/curl/*.h"]),
    defines = ["CURL_STATICLIB"] + select({
        # Prevent <windows.h> from pulling in <winsock.h> ahead of <winsock2.h>.
        "@platforms//os:windows": ["WIN32_LEAN_AND_MEAN"],
        "//conditions:default": [],
    }),
    features = WINDOWS_CRT_FEATURES,
    includes = ["include"],
    deps = [":curl_private"],
)
