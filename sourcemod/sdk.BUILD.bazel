# ---------------------------------------------------------------------------
# Header cc_libraries
#
# Each captures the include paths that are relative to @sourcemod_sdk, so the
# macro (which runs in a different repo context) doesn't need to hardcode paths.
# ---------------------------------------------------------------------------

# Broad headers needed by the loader, logic, and core.
#
# The include roots mirror the logic/core AMBuilders, which put the SourceMod
# root itself on the path: sources reach for <bridge/include/...> spelled
# relative to that root, not to their own directory.
#
# :sourcepawn_internal_headers, not just :sourcepawn_headers (which it already
# pulls in transitively): several core/logic/*.cpp files (DebugReporter.cpp,
# NativeOwner.cpp, PluginSys.cpp, ...) #include
# "sourcepawn/vm/base-runtime.h"/"sourcepawn/vm/environment.h" directly --
# VM-internal headers, not part of sourcepawn_headers' public
# sourcepawn/include/**/*.h glob.
cc_library(
    name = "sm_root_hdrs",
    hdrs = glob([
        "core/*.h",
        "core/logic/*.h",
        "bridge/include/*.h",
        "versionlib/*.h",
    ]),
    includes = [
        "",
        "core",
        "core/logic",
    ],
    deps = [
        ":sourcemod_headers",
        ":sourcepawn_internal_headers",
    ],
)

# safetyhook — the hooking library CDetour is built on, vendored by SourceMod
# as a submodule. Its AMBuilder deliberately *resets* every inherited compiler
# flag and define before building, so this target does not pick up the SDK's
# platform defines either; it is compiled in isolation and only its headers are
# exposed. Zydis arrives pre-amalgamated as one C file.
cc_library(
    name = "safetyhook",
    srcs = [
        "public/safetyhook/src/allocator.cpp",
        "public/safetyhook/src/easy.cpp",
        "public/safetyhook/src/inline_hook.cpp",
        "public/safetyhook/src/mid_hook.cpp",
        "public/safetyhook/src/utility.cpp",
        "public/safetyhook/src/vmt_hook.cpp",
        "public/safetyhook/zydis/Zydis.c",
    ] + select({
        "@platforms//os:windows": ["public/safetyhook/src/os.windows.cpp"],
        "//conditions:default": ["public/safetyhook/src/os.linux.cpp"],
    }),
    hdrs = glob([
        "public/safetyhook/include/**/*.hpp",
        "public/safetyhook/zydis/*.h",
    ]),
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/EHsc", "/permissive-"],
        # Upstream also passes -Werror here; it is dropped for the same reason
        # the extension rules drop it (see README, "What was removed and why").
        #
        # This target does not take the shared suppressions from
        # //sourcemod:warnings.bzl, because upstream's AMBuilder resets every
        # inherited flag before building safetyhook and this mirrors that. The
        # two -Wno-unused-* are what the amalgamated Zydis needs on its own: it
        # defines a full opcode table, most of which any single build leaves
        # untouched.
        "//conditions:default": [
            "-fPIC",
            "-Wno-unused-function",
            "-Wno-unused-const-variable",
        ],
    }),
    includes = [
        "public/safetyhook/include",
        "public/safetyhook/zydis",
    ],
)

cc_library(
