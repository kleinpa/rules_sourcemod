"""Build overlay for the fetched SourceMod SDK sources.

The SDK is consumed as source and compiled with the consumer's own C++
toolchain. The include roots below mirror `ConfigureForExtension()` in the
AMBuild template this replaces.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_sourcemod//sourcemod:defines.bzl", "SOURCEMOD_PLATFORM_DEFINES")
load(
    "@rules_sourcemod//sourcemod:plugins.bzl",
    "ACTIVE_PLUGINS",
    "DISABLED_PLUGINS",
    "PLUGINS_WITH_PARTS",
)
load("@rules_sourcemod//sourcemod:warnings.bzl", "UPSTREAM_WARNING_COPTS")
load("@rules_sourcemod//spcomp:plugin.bzl", "sourcemod_plugin")
load(
    "@rules_sourcemod//spcomp:sources.bzl",
    "SPCOMP_AMTL_SRCS",
    "SPCOMP_COMPILER_SRCS",
    "SPCOMP_LIBSMX_SRCS",
    "SPCOMP_VM_SRCS",
    "SPCOMP_VM_SRCS_X86",
    "SPCOMP_VM_SRCS_X86_64",
)
load("@rules_sourcemod//spcomp:version.bzl", "sourcemod_version_header")

package(default_visibility = ["//visibility:public"])

licenses(["restricted"])  # GPL-3.0 with linking exception for extensions.

exports_files(["public/smsdk_ext.cpp"])

# AMTL — AlliedModders template library. Header-only.
# Two include roots: `amtl/` prefixed and unprefixed, matching upstream, which
# passes both `public/amtl` and `public/amtl/amtl`.
cc_library(
    name = "amtl",
    hdrs = glob(
        [
            "public/amtl/amtl/**/*.h",
            "public/amtl/**/*.h",
        ],
        allow_empty = False,
    ),
    includes = [
        "public/amtl",
        "public/amtl/amtl",
    ],
)

# SourcePawn VM API headers (sp_vm_api.h, sp_vm_types.h, ...). Header-only; the
# VM itself lives in the SourceMod runtime, not in the extension.
cc_library(
    name = "sourcepawn_headers",
    hdrs = glob(
        ["sourcepawn/include/**/*.h"],
        allow_empty = False,
    ),
    includes = ["sourcepawn/include"],
    deps = [":amtl"],
)

# The public SourceMod interface headers an extension talks to
# (IShareSys, IGameHelpers, IPlayerHelpers, IExtensionSys, ...).
cc_library(
    name = "sourcemod_headers",
    hdrs = glob(
        [
            "public/*.h",
            "public/extensions/*.h",
        ],
        allow_empty = False,
    ),
    defines = SOURCEMOD_PLATFORM_DEFINES,
    includes = [
        "public",
        "public/extensions",
    ],
    deps = [
        ":amtl",
        ":sourcepawn_headers",
    ],
)

# ---------------------------------------------------------------------------
# SourcePawn compiler (spcomp), built from source.
#
# Everything below produces the .sp -> .smx compiler. It is a build tool, so it
# is always built for the execution platform; see spcomp/sources.bzl for why
# that also determines which VM backend is compiled.
# ---------------------------------------------------------------------------

# zlib, vendored in the SourcePawn tree. spcomp uses it to compress the code
# section of the .smx it emits.
cc_library(
    name = "zlib",
    srcs = glob(
        ["sourcepawn/third_party/zlib/*.c"],
        allow_empty = False,
    ),
    hdrs = glob(
        ["sourcepawn/third_party/zlib/*.h"],
        allow_empty = False,
    ),
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-Wno-implicit-function-declaration"],
    }),
    # Both spellings are needed: zlib's own sources use `#include "zutil.h"`,
    # while the compiler reaches for `<zlib/zlib.h>`.
    includes = [
        "sourcepawn/third_party",
        "sourcepawn/third_party/zlib",
    ],
)

# `sourcemod_version.h`, which the compiler includes for its version banner.
# The version is read from the fetched tree's product.version at repository
# setup time; the header is written from Starlark, so this needs neither Python
# nor a shell (see spcomp/version.bzl).
sourcemod_version_header(
    name = "sourcemod_version_h",
    version = "%{product_version}",
)

cc_library(
    name = "sourcemod_version_header",
    hdrs = [":sourcemod_version_h"],
    includes = ["generated"],
)

# Headers shared between the compiler and the VM.
cc_library(
    name = "sourcepawn_internal_headers",
    hdrs = glob(
        [
            "sourcepawn/compiler/**/*.h",
            "sourcepawn/compiler/**/*-inl.h",
            "sourcepawn/libsmx/*.h",
            "sourcepawn/shared/*.h",
            "sourcepawn/vm/**/*.h",
        ],
        allow_empty = False,
    ),
    includes = [
        "sourcepawn",
        "sourcepawn/vm",
    ],
    deps = [
        ":amtl",
        ":sourcemod_version_header",
        ":sourcepawn_headers",
    ],
)

_SPCOMP_COPTS = select({
    "@platforms//os:windows": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
}) + UPSTREAM_WARNING_COPTS

# WIN32 is not predefined by MSVC (which spells it _WIN32); upstream's
# configure_windows adds it to every target. dll_exports.h gates EXPORTFUNC on
# it, so without it the VM's exported GetSourcePawnFactory silently loses its
# declaration and the file fails to parse.
_SPCOMP_DEFINES = select({
    "@platforms//os:linux": ["_GNU_SOURCE"],
    "@platforms//os:macos": ["DARWIN"],
    "@platforms//os:windows": ["WIN32", "_WINDOWS"],
    "//conditions:default": [],
})

# The SourcePawn VM. Linked into spcomp because the assembler runs each freshly
# built binary through the VM's verifier before writing it out, and into the
# runtime shared library below, which is what the game server loads.
#
# alwayslink because that shared library's only translation unit of its own is
# the export shim: everything else has to survive archive member selection on
# the strength of being reachable from it, and the VM registers work from static
# initializers that no symbol reference would pull in.
cc_library(
    name = "sourcepawn_vm",
    srcs = SPCOMP_VM_SRCS + select({
        "@platforms//cpu:x86_32": SPCOMP_VM_SRCS_X86,
        "//conditions:default": SPCOMP_VM_SRCS_X86_64,
    }),
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES + select({
        # The JIT only exists in the 32-bit backend.
        "@platforms//cpu:x86_32": ["SP_HAS_JIT"],
        "//conditions:default": [],
    }),
    alwayslink = True,
    deps = [
        ":sourcepawn_internal_headers",
        ":zlib",
    ],
)

# The SourcePawn runtime, as the shared library the server dlopens.
#
# SourceMod's core opens `addons/sourcemod/bin/x64/sourcepawn.vm.so` during
# startup (SOURCEPAWN_DLL in core/sourcemod.cpp) and resolves
# GetSourcePawnFactory out of it; without the file, core refuses to start and
# MetaMod reports "Failed to load plugin addons/sourcemod/bin/sourcemod_mm",
# which is indistinguishable from SourceMod not being installed at all.
#
# Same code as is linked into spcomp, plus dll_exports.cpp -- upstream's
# vm/AMBuilder builds that file only into the shared module, since it carries
# the exported factory function and the module's operator new/delete.
cc_binary(
    name = "sourcepawn_vm_shared",
    srcs = ["sourcepawn/vm/dll_exports.cpp"],
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    linkopts = select({
        "@platforms//os:windows": [],
        # See spcomp below: the VM's thread support needs pthread named
        # explicitly to keep linking against a pre-2.34 glibc working.
        "//conditions:default": ["-lpthread"],
    }),
    linkshared = True,
    deps = [
        ":sourcepawn_internal_headers",
        ":sourcepawn_vm",
    ],
)

# The compiler front end, .smx writer, and amtl's argument parser.
cc_library(
    name = "sourcepawn_compiler",
    srcs = SPCOMP_COMPILER_SRCS + SPCOMP_LIBSMX_SRCS + SPCOMP_AMTL_SRCS,
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    deps = [
        ":sourcepawn_internal_headers",
        ":sourcepawn_vm",
        ":zlib",
    ],
)

cc_binary(
    name = "spcomp",
    srcs = ["sourcepawn/compiler/driver.cpp"],
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    linkopts = select({
        # driver.cpp posts window messages to notify an editor of build results.
        "@platforms//os:windows": ["user32.lib"],
        # The VM's thread support needs pthread. Explicit because glibc only
        # folded libpthread into libc in 2.34: linking against an older sysroot
        # (which is what keeps the output loadable on older targets) still needs
        # it named, even though a modern host would resolve it from libc.
        "//conditions:default": ["-lpthread"],
    }),
    deps = [
        ":sourcepawn_compiler",
        ":sourcepawn_internal_headers",
    ],
)

# The SourcePawn standard library (`#include <sourcemod>` and friends), taken
# from the same SourceMod source tree as everything else. Previously these came
# from the prebuilt binary drop.
filegroup(
    name = "spcomp_stdlib_includes",
    srcs = glob(
        ["plugins/include/**/*.inc"],
        allow_empty = False,
    ),
)

