"""Build overlay for `@sourcemod_sdk`."""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import", "cc_library")
load(
    "@rules_sourcemod//private:flags.bzl",
    "SERVER_COPTS",
    "SERVER_LINKOPTS",
    "SOURCEMOD_PLATFORM_DEFINES",
    "UPSTREAM_WARNING_COPTS",
    "UPSTREAM_WINDOWS_LINKOPTS",
    "WINDOWS_CRT_FEATURES",
)
load("@rules_sourcemod//private:shared_lib.bzl", "shared_lib_output")
load("@rules_sourcemod//sourcemod:plugins.bzl", "BUNDLED_PLUGINS")
load("@rules_sourcemod//spcomp:plugin.bzl", "sourcemod_plugin")

package(default_visibility = ["//visibility:public"])

licenses(["restricted"])  # GPL-3.0 with linking exception for extensions.

exports_files(["public/smsdk_ext.cpp"])

cc_library(
    name = "amtl",
    hdrs = glob(
        [
            "public/amtl/amtl/**/*.h",
            "public/amtl/**/*.h",
        ],
        allow_empty = False,
    ),
    includes = [
        "public/amtl",
        "public/amtl/amtl",
    ],
)

cc_library(
    name = "sourcepawn_headers",
    hdrs = glob(["sourcepawn/include/**/*.h"], allow_empty = False),
    includes = ["sourcepawn/include"],
    deps = [":amtl"],
)

cc_library(
    name = "sourcemod_headers",
    hdrs = glob(
        [
            "public/*.h",
            "public/extensions/*.h",
        ],
        allow_empty = False,
    ),
    defines = SOURCEMOD_PLATFORM_DEFINES,
    includes = [
        "public",
        "public/extensions",
    ],
    deps = [
        ":amtl",
        ":sourcepawn_headers",
    ],
)

# ---------------------------------------------------------------------------
# SourcePawn compiler (spcomp) and runtime VM
# ---------------------------------------------------------------------------

cc_library(
    name = "zlib",
    srcs = glob(["sourcepawn/third_party/zlib/*.c"], allow_empty = False),
    hdrs = glob(["sourcepawn/third_party/zlib/*.h"], allow_empty = False),
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": [],
        "//conditions:default": ["-Wno-implicit-function-declaration"],
    }),
    features = WINDOWS_CRT_FEATURES,
    includes = [
        "sourcepawn/third_party",
        "sourcepawn/third_party/zlib",
    ],
)

cc_library(
    name = "sourcepawn_internal_headers",
    hdrs = glob(
        [
            "sourcepawn/compiler/**/*.h",
            "sourcepawn/libsmx/*.h",
            "sourcepawn/shared/*.h",
            "sourcepawn/vm/**/*.h",
        ],
        allow_empty = False,
    ) + ["generated/sourcemod_version.h"],  # Written by //sourcemod:repositories.bzl.
    includes = [
        "generated",
        "sourcepawn",
        "sourcepawn/vm",
    ],
    deps = [
        ":amtl",
        ":sourcepawn_headers",
    ],
)

_SPCOMP_COPTS = select({
    "@rules_cc//cc/compiler:msvc-cl": ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
}) + UPSTREAM_WARNING_COPTS

_SPCOMP_DEFINES = select({
    "@platforms//os:linux": ["_GNU_SOURCE"],
    "@platforms//os:windows": ["WIN32", "_WINDOWS"],
    "//conditions:default": [],
})

# Sources mirror sourcepawn's vm/, libsmx/ and compiler/ AMBuilder files.
cc_library(
    name = "sourcepawn_vm",
    srcs = [
        "sourcepawn/vm/api.cpp",
        "sourcepawn/vm/base-context.cpp",
        "sourcepawn/vm/builtins.cpp",
        "sourcepawn/vm/code-allocator.cpp",
        "sourcepawn/vm/code-stubs.cpp",
        "sourcepawn/vm/compiled-function.cpp",
        "sourcepawn/vm/control-flow.cpp",
        "sourcepawn/vm/debugging.cpp",
        "sourcepawn/vm/debug-metadata.cpp",
        "sourcepawn/vm/environment.cpp",
        "sourcepawn/vm/file-utils.cpp",
        "sourcepawn/vm/graph-builder.cpp",
        "sourcepawn/vm/interpreter.cpp",
        "sourcepawn/vm/md5/md5.cpp",
        "sourcepawn/vm/method-info.cpp",
        "sourcepawn/vm/method-verifier.cpp",
        "sourcepawn/vm/opcodes.cpp",
        "sourcepawn/vm/plugin-context.cpp",
        "sourcepawn/vm/plugin-runtime.cpp",
        "sourcepawn/vm/pool-allocator.cpp",
        "sourcepawn/vm/rtti.cpp",
        "sourcepawn/vm/runtime-helpers.cpp",
        "sourcepawn/vm/scripted-invoker.cpp",
        "sourcepawn/vm/smx-v1-image.cpp",
        "sourcepawn/vm/stack-frames.cpp",
        "sourcepawn/vm/watchdog_timer.cpp",
    ] + select({
        # Upstream's JIT is x86-only; x86_64 interprets bytecode.
        "@platforms//cpu:x86_32": [
            "sourcepawn/vm/jit.cpp",
            "sourcepawn/vm/linking.cpp",
            "sourcepawn/vm/x86/assembler-x86.cpp",
            "sourcepawn/vm/x86/code-stubs-x86.cpp",
            "sourcepawn/vm/x86/jit_x86.cpp",
        ],
        "//conditions:default": [
            "sourcepawn/vm/x64/assembler-x64.cpp",
            "sourcepawn/vm/x64/code-stubs-x64.cpp",
            "sourcepawn/vm/x64/macro-assembler-x64.cpp",
        ],
    }),
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES + select({
        "@platforms//cpu:x86_32": ["SP_HAS_JIT"],
        "//conditions:default": [],
    }),
    features = WINDOWS_CRT_FEATURES,
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-lpthread"],
    }),
    deps = [
        ":sourcepawn_internal_headers",
        ":zlib",
    ],
    alwayslink = True,
)

# `driver.cpp` holds main() and is added on the `spcomp` cc_binary.
cc_library(
    name = "sourcepawn_compiler",
    srcs = [
        "public/amtl/amtl/experimental/am-argparser.cpp",
        "sourcepawn/compiler/array-helpers.cpp",
        "sourcepawn/compiler/assembler.cpp",
        "sourcepawn/compiler/builtin-generator.cpp",
        "sourcepawn/compiler/code-generator.cpp",
        "sourcepawn/compiler/compile-context.cpp",
        "sourcepawn/compiler/data-queue.cpp",
        "sourcepawn/compiler/errors.cpp",
        "sourcepawn/compiler/expressions.cpp",
        "sourcepawn/compiler/lexer.cpp",
        "sourcepawn/compiler/main.cpp",
        "sourcepawn/compiler/name-resolution.cpp",
        "sourcepawn/compiler/parse-node.cpp",
        "sourcepawn/compiler/parser.cpp",
        "sourcepawn/compiler/pool-allocator.cpp",
        "sourcepawn/compiler/pool-objects.cpp",
        "sourcepawn/compiler/sci18n.cpp",
        "sourcepawn/compiler/scopes.cpp",
        "sourcepawn/compiler/sctracker.cpp",
        "sourcepawn/compiler/semantics.cpp",
        "sourcepawn/compiler/source-file.cpp",
        "sourcepawn/compiler/source-manager.cpp",
        "sourcepawn/compiler/symbols.cpp",
        "sourcepawn/compiler/type-checker.cpp",
        "sourcepawn/compiler/types.cpp",
        "sourcepawn/libsmx/data-pool.cpp",
        "sourcepawn/libsmx/smx-builder.cpp",
    ],
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    features = WINDOWS_CRT_FEATURES,
    deps = [
        ":sourcepawn_internal_headers",
        ":sourcepawn_vm",
        ":zlib",
    ],
)

_SPCOMP_LINKOPTS = select({
    "@platforms//os:windows": ["user32.lib"],
    "//conditions:default": [],
})

# Shared runtime dlopen'd by SourceMod core (`sourcepawn.vm` on x64, `sourcepawn.jit.x86` on x86).
cc_binary(
    name = "sourcepawn_vm_bin",
    srcs = ["sourcepawn/vm/dll_exports.cpp"],
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    features = WINDOWS_CRT_FEATURES,
    linkopts = _SPCOMP_LINKOPTS,
    linkshared = True,
    deps = [
        ":sourcepawn_compiler",
        ":sourcepawn_internal_headers",
    ],
)

shared_lib_output(
    name = "sourcepawn_vm_shared",
    binary = ":sourcepawn_vm_bin",
)

cc_binary(
    name = "spcomp",
    srcs = ["sourcepawn/compiler/driver.cpp"],
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    features = WINDOWS_CRT_FEATURES,
    linkopts = _SPCOMP_LINKOPTS,
    deps = [
        ":sourcepawn_compiler",
        ":sourcepawn_internal_headers",
    ],
)

# Standalone SourcePawn VM runner (`public main()`) used by `sourcemod_test`.
cc_binary(
    name = "spshell",
    srcs = ["sourcepawn/vm/shell/shell.cpp"],
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES + select({
        "@platforms//cpu:x86_32": ["SP_HAS_JIT"],
        "//conditions:default": [],
    }),
    features = WINDOWS_CRT_FEATURES,
    deps = [
        ":sourcepawn_compiler",
        ":sourcepawn_internal_headers",
    ],
)

filegroup(
    name = "spcomp_stdlib_includes",
    srcs = glob(["plugins/include/**/*.inc"], allow_empty = False),
)

