)

# Empty `<stem>.autoload` files trigger SourceMod's TryAutoload() on startup.
[write_file(
    name = stem.replace(".", "_") + "_autoload",
    out = stem + ".autoload",
    content = [],
) for stem in [
    "bintools",
    "game.cstrike",
    "game.tf2",
    "sdkhooks",
    "sdktools",
    "topmenus",
]]

# ---------------------------------------------------------------------------
# Bundled SourcePawn plugins (opt-in per server deployment)
# ---------------------------------------------------------------------------

[sourcemod_plugin(
    name = "plugin_" + name,
    src = "plugins/" + name + ".sp",
    extra_srcs = glob(["plugins/" + name + "/*.sp"], allow_empty = True),
    plugin_name = name,
) for name in BUNDLED_PLUGINS]
