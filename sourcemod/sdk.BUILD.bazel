"""Build overlay for the fetched SourceMod SDK sources.

The SDK is consumed as source and compiled with the consumer's own C++
toolchain. The include roots below mirror `ConfigureForExtension()` in the
AMBuild template this replaces.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_sourcemod//sourcemod:defines.bzl", "SOURCEMOD_PLATFORM_DEFINES")
load(
    "@rules_sourcemod//sourcemod:plugins.bzl",
    "ACTIVE_PLUGINS",
    "DISABLED_PLUGINS",
    "PLUGINS_WITH_PARTS",
)
load("@rules_sourcemod//sourcemod:warnings.bzl", "UPSTREAM_WARNING_COPTS")
load("@rules_sourcemod//spcomp:plugin.bzl", "sourcemod_plugin")
load(
    "@rules_sourcemod//spcomp:sources.bzl",
    "SPCOMP_AMTL_SRCS",
    "SPCOMP_COMPILER_SRCS",
    "SPCOMP_LEGACY_COMPILER_SRCS",
    "SPCOMP_LIBSMX_SRCS",
    "SPCOMP_MIMALLOC_SRCS",
    "SPCOMP_UTILS_SRCS",
    "SPCOMP_UTILS_SRCS_LINUX",
    "SPCOMP_VM_SRCS",
    "SPCOMP_VM_SRCS_MACOS",
    "SPCOMP_VM_SRCS_POSIX",
    "SPCOMP_VM_SRCS_WINDOWS",
    "SPCOMP_VM_SRCS_X86",
    "SPCOMP_VM_SRCS_X86_64",
)
load("@rules_sourcemod//spcomp:version.bzl", "sourcemod_version_header")

package(default_visibility = ["//visibility:public"])

licenses(["restricted"])  # GPL-3.0 with linking exception for extensions.

exports_files(["public/smsdk_ext.cpp"])

# AMTL — AlliedModders template library. Header-only.
# Two include roots: `amtl/` prefixed and unprefixed, matching upstream, which
# passes both `public/amtl` and `public/amtl/amtl`.
cc_library(
    name = "amtl",
    hdrs = glob(
        [
            "public/amtl/amtl/**/*.h",
            "public/amtl/**/*.h",
        ],
        allow_empty = False,
    ),
    includes = [
        "public/amtl",
        "public/amtl/amtl",
    ],
)

# SourcePawn VM API headers (sp_vm_api.h, sp_vm_types.h, ...). Header-only; the
# VM itself lives in the SourceMod runtime, not in the extension.
cc_library(
    name = "sourcepawn_headers",
    hdrs = glob(
        ["sourcepawn/include/**/*.h"],
        allow_empty = False,
    ),
    includes = ["sourcepawn/include"],
    deps = [":amtl"],
)

# The public SourceMod interface headers an extension talks to
# (IShareSys, IGameHelpers, IPlayerHelpers, IExtensionSys, ...).
cc_library(
    name = "sourcemod_headers",
    hdrs = glob(
        [
            "public/*.h",
            "public/extensions/*.h",
        ],
        allow_empty = False,
    ),
    defines = SOURCEMOD_PLATFORM_DEFINES,
    includes = [
        "public",
        "public/extensions",
    ],
    deps = [
        ":amtl",
        ":sourcepawn_headers",
    ],
)

# ---------------------------------------------------------------------------
# SourcePawn compilers (spcomp and oldspcomp), built from source.
#
# Everything below produces the .sp -> .smx compilers. They are build tools,
# so they are always built for the execution platform; see spcomp/sources.bzl
# for why that also determines which VM backend is compiled, and for what
# distinguishes the two.
# ---------------------------------------------------------------------------

# zlib, vendored in the SourcePawn tree. spcomp uses it to compress the code
# section of the .smx it emits.
cc_library(
    name = "zlib",
    srcs = glob(
        ["sourcepawn/third_party/zlib/*.c"],
        allow_empty = False,
    ),
    hdrs = glob(
        ["sourcepawn/third_party/zlib/*.h"],
        allow_empty = False,
    ),
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-Wno-implicit-function-declaration"],
    }),
    # Both spellings are needed: zlib's own sources use `#include "zutil.h"`,
    # while the compiler reaches for `<zlib/zlib.h>`.
    includes = [
        "sourcepawn/third_party",
        "sourcepawn/third_party/zlib",
    ],
)

# mimalloc, vendored in the SourcePawn tree as a submodule (see
# _MIMALLOC_COMMIT in @rules_sourcemod//sourcemod:repositories.bzl). The
# SourcePawn 2 heap is built on it, so it goes wherever the VM goes.
#
# MI_STATIC_LIB is what upstream's AMBuild.mimalloc sets: without it
# mimalloc's headers declare its API with shared-library export attributes.
# The textual_hdrs are the translation units mimalloc's own build never
# compiles directly -- they are `#include`d by the sibling listed in
# SPCOMP_MIMALLOC_SRCS -- plus its internal headers. Everything under src/
# goes in rather than a hand-picked list, since which .c includes which is
# mimalloc's business and changes between its releases; listing them as
# textual headers costs nothing, as nothing is compiled from here.
#
# Warnings are silenced outright (-w, /w) as upstream does: it is third-party
# C built with SourcePawn's -Werror, and this module's own suppression set
# (//sourcemod:warnings.bzl) is tuned to SourceMod's C++, not to it.
cc_library(
    name = "mimalloc",
    srcs = SPCOMP_MIMALLOC_SRCS,
    hdrs = glob(
        ["sourcepawn/third_party/mimalloc/include/**/*.h"],
        allow_empty = False,
    ),
    textual_hdrs = glob(
        [
            "sourcepawn/third_party/mimalloc/src/**/*.c",
            "sourcepawn/third_party/mimalloc/src/**/*.h",
        ],
        exclude = SPCOMP_MIMALLOC_SRCS,
        allow_empty = False,
    ),
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/w"],
        "//conditions:default": ["-w"],
    }),
    defines = ["MI_STATIC_LIB"],
    includes = [
        "sourcepawn/third_party/mimalloc/include",
        "sourcepawn/third_party/mimalloc/src",
    ],
)

# `sourcemod_version.h`, which the compilers include for their version banner.
# The version is read from the fetched tree's product.version at repository
# setup time; the header is written from Starlark, so this needs neither Python
# nor a shell (see spcomp/version.bzl).
sourcemod_version_header(
    name = "sourcemod_version_h",
    version = "%{product_version}",
)

cc_library(
    name = "sourcemod_version_header",
    hdrs = [":sourcemod_version_h"],
    includes = ["generated"],
)

# Headers shared between the compilers and the VM. Both compiler directories
# are in here even though no binary links both: they carry files of the same
# names and each includes its own by bare `"lexer.h"`-style quotes, which the
# preprocessor resolves against the including file's directory first, so
# nothing crosses over.
cc_library(
    name = "sourcepawn_internal_headers",
    hdrs = glob(
        [
            "sourcepawn/compiler/**/*.h",
            "sourcepawn/legacy-compiler/**/*.h",
            "sourcepawn/libsmx/*.h",
            "sourcepawn/utils/*.h",
            "sourcepawn/vm/**/*.h",
        ],
        allow_empty = False,
    ),
    includes = [
        "sourcepawn",
        "sourcepawn/vm",
    ],
    deps = [
        ":amtl",
        ":sourcemod_version_header",
        ":sourcepawn_headers",
    ],
)

_SPCOMP_COPTS = select({
    "@platforms//os:windows": ["/std:c++20"],
    "//conditions:default": ["-std=c++20"],
}) + UPSTREAM_WARNING_COPTS

# WIN32 is not predefined by MSVC (which spells it _WIN32); upstream's
# configure_windows adds it to every target.
_SPCOMP_DEFINES = select({
    "@platforms//os:linux": ["_GNU_SOURCE"],
    "@platforms//os:macos": ["DARWIN"],
    "@platforms//os:windows": ["WIN32", "_WINDOWS"],
    "//conditions:default": [],
})

# The SourcePawn VM. Linked into spcomp because the assembler runs each freshly
# built binary through the VM's verifier before writing it out, and directly
# into sourcemod/server.bzl's logic_lib (sourcemod.logic.so): core/logic's
# common_logic.cpp calls sp::Environment::New() directly to get the VM, so
# the VM has to be compiled into whatever calls that, not shipped separately
# for core to dlopen -- see that macro's `logic_lib` cc_library.
#
# alwayslink because logic_lib's own translation units reach the VM only
# through sp::Environment::New() and similar factory calls, not by direct
# symbol reference to individual VM registration code: the VM's native
# registrations run from static initializers that nothing else references
# directly, so without alwayslink the linker would drop them as unreachable.
cc_library(
    name = "sourcepawn_vm",
    srcs = SPCOMP_VM_SRCS + SPCOMP_UTILS_SRCS + select({
        "@platforms//os:linux": SPCOMP_UTILS_SRCS_LINUX,
        "//conditions:default": [],
    }) + select({
        "@platforms//os:windows": SPCOMP_VM_SRCS_WINDOWS,
        "@platforms//os:macos": SPCOMP_VM_SRCS_POSIX + SPCOMP_VM_SRCS_MACOS,
        "//conditions:default": SPCOMP_VM_SRCS_POSIX,
    }) + select({
        "@platforms//cpu:x86_32": SPCOMP_VM_SRCS_X86,
        "//conditions:default": SPCOMP_VM_SRCS_X86_64,
    }),
    copts = _SPCOMP_COPTS,
    # SourcePawn's own AMBuildScript enables both JITs (SP_JIT_V1 for the
    # classic bytecode, SP_JIT_V2 for SourcePawn 2's) for x86 and x86_64
    # alike -- see spcomp/sources.bzl's SPCOMP_VM_SRCS_X86_64/
    # SPCOMP_VM_SRCS_X86 comment. Unconditional here rather than a select()
    # since every real (non-emscripten) target this module builds for
    # wants them. SP_ARCH_STR is the VM's own name for the architecture,
    # reported by `sm version`-style output; upstream spells 64-bit "x64".
    defines = _SPCOMP_DEFINES + [
        "SP_JIT_V1",
        "SP_JIT_V2",
    ] + select({
        "@platforms//cpu:x86_32": ["SP_ARCH_STR=\\\"x86\\\""],
        "//conditions:default": ["SP_ARCH_STR=\\\"x64\\\""],
    }),
    alwayslink = True,
    # The VM's thread support needs pthread. Explicit because glibc only
    # folded libpthread into libc in 2.34: linking against an older sysroot
    # (which is what keeps the output loadable on older targets) still needs
    # it named, even though a modern host would resolve it from libc. Lives
    # here rather than on spcomp/logic_lib individually so both final links
    # that pull this cc_library in (spcomp, and sourcemod/server.bzl's
    # logic_lib) get it the same way, instead of each needing to know why.
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-lpthread"],
    }),
    deps = [
        ":mimalloc",
        ":sourcepawn_internal_headers",
        ":zlib",
    ],
)

# The .smx writer and amtl's argument parser -- the part of a compiler binary
# that is the same for both compilers.
cc_library(
    name = "sourcepawn_compiler_common",
    srcs = SPCOMP_LIBSMX_SRCS + SPCOMP_AMTL_SRCS,
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    deps = [
        ":sourcepawn_internal_headers",
        ":sourcepawn_vm",
        ":zlib",
    ],
)

# The SourcePawn 2 compiler front end.
cc_library(
    name = "sourcepawn_compiler",
    srcs = SPCOMP_COMPILER_SRCS,
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    deps = [":sourcepawn_compiler_common"],
)

# The pre-2.0 compiler front end, kept by upstream as `oldspcomp`.
cc_library(
    name = "sourcepawn_legacy_compiler",
    srcs = SPCOMP_LEGACY_COMPILER_SRCS,
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    deps = [":sourcepawn_compiler_common"],
)

# Both drivers post window messages to notify an editor of build results.
_SPCOMP_LINKOPTS = select({
    "@platforms//os:windows": ["user32.lib"],
    "//conditions:default": [],
})

cc_binary(
    name = "spcomp",
    srcs = ["sourcepawn/compiler/driver.cpp"],
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    linkopts = _SPCOMP_LINKOPTS,
    deps = [
        ":sourcepawn_compiler",
        ":sourcepawn_internal_headers",
    ],
)

# The classic compiler, next to spcomp above (which is what SourceMod builds
# its own plugins with).
cc_binary(
    name = "oldspcomp",
    srcs = ["sourcepawn/legacy-compiler/driver.cpp"],
    copts = _SPCOMP_COPTS,
    defines = _SPCOMP_DEFINES,
    linkopts = _SPCOMP_LINKOPTS,
    deps = [
        ":sourcepawn_internal_headers",
        ":sourcepawn_legacy_compiler",
    ],
)

# The SourcePawn standard library (`#include <sourcemod>` and friends), taken
# from the same SourceMod source tree as everything else. Previously these came
# from the prebuilt binary drop.
filegroup(
    name = "spcomp_stdlib_includes",
    srcs = glob(
        ["plugins/include/**/*.inc"],
        allow_empty = False,
    ),
)

