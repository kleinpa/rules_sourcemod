# ---------------------------------------------------------------------------
# Extension autoload sentinels
#
# SourceMod's TryAutoload() scans addons/sourcemod/extensions/ for *.autoload
# files and loads the matching extension binary. These empty files trigger that
# mechanism. They are not part of the upstream source tree and must be generated.
#
# The stem is the extension name *without* `.ext`: TryAutoload() replaces the
# `.autoload` suffix with `.ext` and hands that to LoadAutoExtension(), which
# appends the game suffix and library extension itself. Naming these
# `sdktools.ext.autoload` instead sends it looking for `sdktools.ext.ext.so`.
#
# One genrule per extension this SDK can produce, not one filegroup bundling
# them all: which sentinels a given game server actually wants depends on
# which branch it's built for (a "game.<x>" one only for branches with a
# per-game extension -- see _GAME_EXTENSIONS in //sourcemod:server.bzl), so
# sourcemod_game_server() picks the individual targets it needs by label
# rather than being handed a fixed bundle that assumes every build is css.
# ---------------------------------------------------------------------------

[genrule(
    name = ext + "_autoload_file",
    outs = [ext + ".autoload"],
    cmd = "touch $@",
) for ext in [
    "sdktools",
    "sdkhooks",
    "game.cstrike",
    "game.tf2",
    "topmenus",
    "bintools",
]]

# ---------------------------------------------------------------------------
# Compiled plugins
#
# All 24 bundled SourceMod plugins. Seven are shipped disabled by default
# (matching AMBuild's PackageScript disabled_plugins set). Of those seven,
# mapchooser / nominations / rockthevote are promoted to the active directory
# by the server macro; the remaining four stay in plugins/disabled/.
# ---------------------------------------------------------------------------

# The parts that multi-file plugins `#include` by relative path.
_PLUGIN_PARTS = glob(
    ["plugins/{}/*.sp".format(name) for name in PLUGINS_WITH_PARTS],
    allow_empty = False,
)

# Each plugin reports its own install directory through PackageFilesInfo, so
# these targets are handed straight to pkg_tar by sourcemod_server(). They are
# deliberately NOT collected into a filegroup first: filegroup forwards only
# DefaultInfo, which would drop the destination and flatten every .smx into the
# root of the layer.
[sourcemod_plugin(
    name = "plugin_" + name,
    src = "plugins/" + name + ".sp",
    extra_srcs = _PLUGIN_PARTS,
    plugin_name = name,
    dest_dir = "addons/sourcemod/plugins/disabled",
) for name in DISABLED_PLUGINS]

[sourcemod_plugin(
    name = "plugin_" + name,
    src = "plugins/" + name + ".sp",
    extra_srcs = _PLUGIN_PARTS,
    plugin_name = name,
    dest_dir = "addons/sourcemod/plugins",
) for name in ACTIVE_PLUGINS]
