"""Build overlay for one fetched HL2SDK engine branch (templated by //hl2sdk:repositories.bzl)."""

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")
load("@rules_sourcemod//private:flags.bzl", "UPSTREAM_WARNING_COPTS", "WINDOWS_CRT_FEATURES")

package(default_visibility = ["//visibility:public"])

licenses(["restricted"])

_INCLUDE_PATHS = %{include_paths}
_BRANCH_DEFINES = %{defines}
_POSIX_ONLY_DEFINES = %{posix_defines}

# Prebuilt tier0 and vstdlib libraries (Valve does not ship their sources).
# Unwired OS/arch slots fall back to a present directory so unselected labels
# parse cleanly; `target_compatible_with` on :hl2sdk_headers blocks selecting them.
cc_import(
    name = "tier0_windows_x86_32",
    interface_library = "%{lib_windows_x86_32}/tier0.lib",
    system_provided = True,
)

cc_import(
    name = "tier0_windows_x86_64",
    interface_library = "%{lib_windows_x86_64}/tier0.lib",
    system_provided = True,
)

cc_import(
    name = "tier0_linux_x86_32",
    shared_library = "%{lib_linux_x86_32}/libtier0_srv.so",
)

cc_import(
    name = "tier0_linux_x86_64",
    shared_library = "%{lib_linux_x86_64}/libtier0_srv.so",
)

cc_import(
    name = "vstdlib_windows_x86_32",
    interface_library = "%{lib_windows_x86_32}/vstdlib.lib",
    system_provided = True,
)

cc_import(
    name = "vstdlib_windows_x86_64",
    interface_library = "%{lib_windows_x86_64}/vstdlib.lib",
    system_provided = True,
)

cc_import(
    name = "vstdlib_linux_x86_32",
    shared_library = "%{lib_linux_x86_32}/libvstdlib_srv.so",
)

cc_import(
    name = "vstdlib_linux_x86_64",
    shared_library = "%{lib_linux_x86_64}/libvstdlib_srv.so",
)

alias(
    name = "tier0_import",
    actual = select({
        "@rules_sourcemod//platforms:is_linux_x86_32": ":tier0_linux_x86_32",
        "@rules_sourcemod//platforms:is_windows_x86_32": ":tier0_windows_x86_32",
        "@rules_sourcemod//platforms:is_windows_x86_64": ":tier0_windows_x86_64",
        "//conditions:default": ":tier0_linux_x86_64",
    }),
)

alias(
    name = "vstdlib_import",
    actual = select({
        "@rules_sourcemod//platforms:is_linux_x86_32": ":vstdlib_linux_x86_32",
        "@rules_sourcemod//platforms:is_windows_x86_32": ":vstdlib_windows_x86_32",
        "@rules_sourcemod//platforms:is_windows_x86_64": ":vstdlib_windows_x86_64",
        "//conditions:default": ":vstdlib_linux_x86_64",
    }),
)

_SDK_LIB_COPTS = select({
    "@rules_cc//cc/compiler:msvc-cl": ["/W3", "/EHsc"],
    "//conditions:default": [
        "-fPIC",
        "-fno-strict-aliasing",
        "-Wno-write-strings",
    ],
}) + UPSTREAM_WARNING_COPTS

# tier1 and mathlib are compiled from source (matching SdkHelpers.ambuild)
# rather than consuming prebuilt archives built by an unknown toolchain.
cc_library(
    name = "tier1",
    srcs = glob(
        ["tier1/*.cpp"],
        exclude = [
            "tier1/processor_detect.cpp",
            "tier1/processor_detect_linux.cpp",
            # Separate tier1_xbox.vcproj target upstream; includes common/xbox/xboxstubs.h,
            # which is absent from ep1's include paths and unused on PC servers.
            "tier1/xboxstubs.cpp",
        ],
        allow_empty = True,
    ) + select({
        "@platforms//os:windows": ["tier1/processor_detect.cpp"],
        "//conditions:default": ["tier1/processor_detect_linux.cpp"],
    }),
    hdrs = glob(
        [
            "tier1/*.h",
            "utils/lzma/C/*.h",
        ],
        allow_empty = True,
    ),
    copts = _SDK_LIB_COPTS,
    features = WINDOWS_CRT_FEATURES,
    includes = ["tier1"],
    deps = [":hl2sdk_headers"],
)

cc_library(
    name = "mathlib",
    srcs = glob(["mathlib/*.cpp"], allow_empty = True),
    hdrs = glob(["mathlib/*.h"], allow_empty = True),
    copts = _SDK_LIB_COPTS,
    features = WINDOWS_CRT_FEATURES,
    includes = ["mathlib"],
    deps = [":hl2sdk_headers"],
)

# `game_shared/**` and `dlls/**` below cover ep1's pre-Orange-Box directory layout;
# `allow_empty = True` keeps branches lacking any individual pattern valid.
cc_library(
    name = "hl2sdk_headers",
    hdrs = glob(
        [
            "common/**/*.h",
            "game/shared/**/*.h",
            "game/shared/**/*.inc",
            "game_shared/**/*.h",
            "game_shared/**/*.inc",
            "public/**/*.h",
            "public/**/*.H",
            "public/**/*.inl",
        ],
        allow_empty = True,
    ),
    defines = [
        "SOURCE_ENGINE=%{source_engine_code}",
        "GAME_DLL",
        "RAD_TELEMETRY_DISABLED",
    ] + _BRANCH_DEFINES + %{se_defines} + select({
        # COMPILER_MSVC32 vs COMPILER_MSVC64 selects `__asm pause` vs `_mm_pause()` in threadtools.h.
        "@rules_sourcemod//platforms:is_windows_x86_64": [
            "COMPILER_MSVC",
            "COMPILER_MSVC64",
            "WIN32",
            "WIN64",
        ],
        "@platforms//os:windows": [
            "COMPILER_MSVC",
            "COMPILER_MSVC32",
            "WIN32",
        ],
        "//conditions:default": [
            "COMPILER_GCC",
            "_LINUX",
            "LINUX",
            "POSIX",
            "GNUC",
            # Older branches' threadtools.h (AUTO_LOCK) spell GNU `typeof`,
            # which strict -std=c++17 lacks.
            "typeof=__typeof__",
        ] + _POSIX_ONLY_DEFINES,
    }) + select({
        "@platforms//cpu:x86_64": [
            "X64BITS",
            "PLATFORM_64BITS",
        ],
        "//conditions:default": [],
    }),
    includes = _INCLUDE_PATHS,
    linkopts = select({
        "@platforms//os:windows": ["legacy_stdio_definitions.lib"],
        "//conditions:default": ["-lm"],
    }),
    target_compatible_with = %{target_compatible_with},
    deps = [
        ":tier0_import",
        ":vstdlib_import",
    ],
)

# Entity/server internals (`variant_t.h`, `baseentity.h`), kept separate so only
# extensions that need them (e.g. sdktools) add `game/server` to their include path.
cc_library(
    name = "hl2sdk_game_server",
    hdrs = glob(
        [
            "game/server/**/*.h",
            "game/server/**/*.inl",
            "dlls/**/*.h",
            "dlls/**/*.inl",
        ],
        allow_empty = True,
    ),
    includes = [
        "game/server",
        "game/shared",
        "dlls",
    ],
    deps = [":hl2sdk_headers"],
)

cc_library(
    name = "hl2sdk_libs",
    deps = [
        ":hl2sdk_headers",
        ":mathlib",
        ":tier1",
    ],
)

cc_library(
    name = "hl2sdk",
    deps = [
        ":hl2sdk_libs",
        "@metamod_source//:metamod_headers",
    ],
)
